# ==============================================================================
# Variables d'Environnement de Production - Livraison Manager
# A installer sous /etc/livraison/livraison.env avec permissions restreintes :
#   sudo chown root:livraison /etc/livraison/livraison.env
#   sudo chmod 600 /etc/livraison/livraison.env
# ==============================================================================

# Profil Spring Boot actif
SPRING_PROFILES_ACTIVE=prod

# Base de données MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=livraisonProject
DB_USERNAME=livraison_user
DB_PASSWORD=ChangerCeMotDePasseTresFort123!
DB_URL=jdbc:mysql://127.0.0.1:3306/livraisonProject?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&characterEncoding=UTF-8&serverTimezone=UTC

# Validation stricte du schéma Flyway
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Secret JWT (Générer une clé aléatoire 256-bit d'au moins 32 caractères)
# Exemple de génération : openssl rand -base64 48
JWT_SECRET=R3AL_PR0D_JWT_S3CR3T_KEY_REPLACE_WITH_OPENSSL_RAND_BASE64_48_CHARS!
JWT_EXPIRATION_MS=86400000

# Origine(s) CORS autorisée(s) (Vrai domaine du client, ex: https://livraison.mondomaine.com)
CORS_ALLOWED_ORIGINS=https://livraison.votredomaine.com,https://www.livraison.votredomaine.com

# Sauvegardes
BACKUP_DIR=/var/backups/livraison_mysql
RETENTION_DAYS=7

